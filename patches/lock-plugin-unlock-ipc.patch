--- a/plugins/lock/Service.qml
+++ b/plugins/lock/Service.qml
@@ -528,6 +528,17 @@
       return "ok"
     }

+    // Added by bleguard for BLE-proximity auto-unlock.
+    // Bypasses PAM — the caller proves presence via BLE proximity +
+    // stable-presence timer. Security trade-off: a relay attacker within
+    // BLE range could trigger this. Acceptable in trusted environments,
+    // equivalent to macOS / Windows smart-unlock.
+    function unlock(): string {
+      if (!root.currentlyLocked()) return "not-locked"
+      root.finishUnlock()
+      return "ok"
+    }
+
     function isLocked(): string {
       return root.currentlyLocked() ? "true" : "false"
     }
